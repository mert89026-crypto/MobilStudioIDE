<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dashboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- ÜST BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/txtAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MobilStudio IDE"
            android:textColor="#111827"
            android:textSize="21sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Ayarlar"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_manage"
            android:tint="#374151" />

    </LinearLayout>

    <!-- ARAMA -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_below="@id/topBar"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:background="#FFFFFF"
        android:elevation="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Ara"
            android:src="@android:drawable/ic_menu_search"
            android:tint="#6B7280" />

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Proje ara..."
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:textColor="#111827"
            android:textColorHint="#9CA3AF"
            android:textSize="15sp" />

    </LinearLayout>

    <!-- AKSİYON BUTONLARI -->
    <LinearLayout
        android:id="@+id/actionButtons"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/searchContainer"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnNewProject"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Yeni Proje"
            android:textAllCaps="false" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btnClone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="GitHub'dan Al"
            android:textAllCaps="false" />

    </LinearLayout>

    <!-- PROJE BAŞLIĞI -->
    <LinearLayout
        android:id="@+id/projectHeader"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/actionButtons"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtProjects"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Projelerim"
            android:textColor="#111827"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtProjectCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 proje"
            android:textColor="#6B7280"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- PROJE LİSTESİ -->
    <ListView
        android:id="@+id/listProjects"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/projectHeader"
        android:layout_above="@id/fabNewProject"
        android:layout_marginTop="2dp"
        android:clipToPadding="false"
        android:divider="#E5E7EB"
        android:dividerHeight="1dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="16dp"
        android:scrollbars="vertical" />

    <!-- YENİ PROJE FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNewProject"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="20dp"
        android:contentDescription="Yeni proje"
        app:srcCompat="@android:drawable/ic_input_add" />

</RelativeLayout>
